rules_version = '2';
// Zabbadat live boards (project: zabbadat-5f132).
// Deploy: Firebase console > Firestore Database > Rules (paste + Publish),
//         or `firebase deploy --only firestore:rules` with this file.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function ownsNew() { return request.resource.data.uid == request.auth.uid; }
    function shortString(v, max) { return v is string && v.size() <= max; }

    // Washers games: only verified, plausible results can be posted. No edits or deletes.
    match /games/{id} {
      allow read: if true;
      allow create: if signedIn() && ownsNew()
        && request.resource.data.keys().hasOnly(
             ['name','xHandle','uid','score','steps','ms','verified','sensorSamples','maxGapMs','packs','createdAt'])
        && request.resource.data.keys().hasAll(['name','uid','score','steps','ms','verified','createdAt'])
        && shortString(request.resource.data.name, 40)
        && (!('xHandle' in request.resource.data) || shortString(request.resource.data.xHandle, 21))
        && request.resource.data.score == 21
        && request.resource.data.steps is int
        && request.resource.data.steps >= 20 && request.resource.data.steps <= 20000
        && request.resource.data.ms is int
        && request.resource.data.ms >= 60000 && request.resource.data.ms <= 21600000
        && request.resource.data.verified == true
        && (!('sensorSamples' in request.resource.data) || (request.resource.data.sensorSamples is int && request.resource.data.sensorSamples > 0))
        && (!('maxGapMs' in request.resource.data) || (request.resource.data.maxGapMs is int && request.resource.data.maxGapMs <= 1500))
        && (!('packs' in request.resource.data) || request.resource.data.packs is int)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Pushup sets (unchanged behaviour, now validated). No edits or deletes.
    match /pushups/{id} {
      allow read: if true;
      allow create: if signedIn() && ownsNew()
        && request.resource.data.keys().hasOnly(['name','xHandle','uid','reps','ms','createdAt'])
        && shortString(request.resource.data.name, 40)
        && (!('xHandle' in request.resource.data) || shortString(request.resource.data.xHandle, 21))
        && request.resource.data.reps is int
        && request.resource.data.reps >= 0 && request.resource.data.reps <= 5000
        && request.resource.data.ms is number && request.resource.data.ms >= 0
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Plank holds: longest hold board. Create only, limited fields, ms capped at 2 hours.
    // Plank holds: camera sessions only. holdSec must fit inside the time since the
    // camera session started (+10 s slack), and ms must agree with holdSec.
    match /planks/{id} {
      allow read: if true;
      allow create: if signedIn() && ownsNew()
        && request.resource.data.keys().hasOnly(['name','xHandle','uid','ms','holdSec','source','sessionStartedAt','createdAt'])
        && request.resource.data.keys().hasAll(['name','uid','ms','holdSec','source','sessionStartedAt','createdAt'])
        && shortString(request.resource.data.name, 40)
        && (!('xHandle' in request.resource.data) || shortString(request.resource.data.xHandle, 21))
        && request.resource.data.ms is number
        && request.resource.data.ms > 0 && request.resource.data.ms <= 7200000
        && request.resource.data.source == 'camera'
        && request.resource.data.holdSec is int
        && request.resource.data.holdSec >= 0 && request.resource.data.holdSec <= 7200
        && request.resource.data.ms >= request.resource.data.holdSec * 1000
        && request.resource.data.ms < (request.resource.data.holdSec + 1) * 1000
        && request.resource.data.sessionStartedAt is int
        && request.resource.data.sessionStartedAt <= request.time.toMillis() + 10000
        && request.resource.data.holdSec * 1000 <= request.time.toMillis() - request.resource.data.sessionStartedAt + 10000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Plank sets today: one doc per person per local day, id = uid + "_" + YYYY-MM-DD.
    // Camera sessions only; values only go up; total time cannot grow faster than the clock.
    function plankDailyOk(d) {
      return d.keys().hasOnly(['name','xHandle','uid','date','sets','totalSec','bestSec','source','sessionStartedAt','updatedAt'])
        && d.keys().hasAll(['name','uid','date','sets','totalSec','bestSec','source','sessionStartedAt','updatedAt'])
        && shortString(d.name, 40) && d.name.size() > 0
        && (!('xHandle' in d) || shortString(d.xHandle, 21))
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.source == 'camera'
        && d.sets is int && d.sets > 0 && d.sets <= 100
        && d.totalSec is int && d.totalSec > 0 && d.totalSec <= 14400
        && d.bestSec is int && d.bestSec >= 10 && d.bestSec <= 7200 && d.bestSec <= d.totalSec
        && d.totalSec >= d.sets * 10
        && d.sessionStartedAt is int && d.sessionStartedAt <= request.time.toMillis() + 10000
        && d.bestSec * 1000 <= request.time.toMillis() - d.sessionStartedAt + 10000
        && d.updatedAt == request.time;
    }
    match /plankDaily/{id} {
      allow read: if true;
      allow create: if signedIn() && ownsNew()
        && id == request.auth.uid + '_' + request.resource.data.date
        && plankDailyOk(request.resource.data)
        && request.resource.data.totalSec * 1000 <= request.time.toMillis() - request.resource.data.sessionStartedAt + 10000;
      allow update: if signedIn() && ownsNew()
        && resource.data.uid == request.auth.uid
        && request.resource.data.date == resource.data.date
        && id == request.auth.uid + '_' + request.resource.data.date
        && plankDailyOk(request.resource.data)
        && request.resource.data.sets >= resource.data.sets
        && request.resource.data.sets <= resource.data.sets + 1
        && request.resource.data.totalSec >= resource.data.totalSec
        && request.resource.data.bestSec >= resource.data.bestSec
        && (request.resource.data.totalSec - resource.data.totalSec) * 1000
             <= request.time.toMillis() - resource.data.updatedAt.toMillis() + 10000;
      allow delete: if false;
    }

    // Daily steps: one doc per person per local day, id = uid + "_" + YYYY-MM-DD.
    // Steps can only go up, capped at 60,000. No deletes.
    function dailyStepsOk(d) {
      return d.keys().hasOnly(['name','xHandle','uid','date','steps','source','updatedAt'])
        && d.keys().hasAll(['name','uid','date','steps','source','updatedAt'])
        && shortString(d.name, 40) && d.name.size() > 0
        && (!('xHandle' in d) || shortString(d.xHandle, 21))
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.steps is int && d.steps > 0 && d.steps <= 60000
        && d.source in ['native', 'web']
        && d.updatedAt == request.time;
    }
    match /dailySteps/{id} {
      allow read: if true;
      allow create: if signedIn() && ownsNew()
        && id == request.auth.uid + '_' + request.resource.data.date
        && dailyStepsOk(request.resource.data);
      allow update: if signedIn() && ownsNew()
        && resource.data.uid == request.auth.uid
        && request.resource.data.date == resource.data.date
        && id == request.auth.uid + '_' + request.resource.data.date
        && dailyStepsOk(request.resource.data)
        && request.resource.data.steps >= resource.data.steps;
      allow delete: if false;
    }

    // Live walk sessions: one doc per finished web live walk. Create only.
    // 1 min to 4 h, steps 0..40,000 (client also requires 30+ steps/min). No edits or deletes.
    match /walkSessions/{id} {
      allow read: if true;
      allow create: if signedIn() && ownsNew()
        && request.resource.data.keys().hasOnly(['name','xHandle','uid','ms','steps','createdAt'])
        && request.resource.data.keys().hasAll(['name','uid','ms','steps','createdAt'])
        && shortString(request.resource.data.name, 40) && request.resource.data.name.size() > 0
        && (!('xHandle' in request.resource.data) || shortString(request.resource.data.xHandle, 21))
        && request.resource.data.ms is int
        && request.resource.data.ms >= 60000 && request.resource.data.ms <= 14400000
        && request.resource.data.steps is int
        && request.resource.data.steps >= 0 && request.resource.data.steps <= 40000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Stripe membership status. Written only by the server (Netlify stripe-webhook via firebase-admin).
    match /members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Live walk mirror: one doc per user, the active session shown on their other devices.
    match /liveWalk/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','active','startedAt','activeMs','steps','paused','updatedAt'])
        && request.resource.data.keys().hasAll(['uid','active','startedAt','activeMs','steps','paused','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.active is bool
        && request.resource.data.paused is bool
        && request.resource.data.startedAt is int
        && request.resource.data.activeMs is number
        && request.resource.data.activeMs >= 0 && request.resource.data.activeMs <= 14400000
        && request.resource.data.steps is int
        && request.resource.data.steps >= 0 && request.resource.data.steps <= 40000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Plank Battles rooms: two equal players, no host. DRAFT, not yet published.
    match /battles/{code} {
      function signedIn() { return request.auth != null; }
      function me() { return request.auth.uid; }
      function d() { return resource.data; }
      function n() { return request.resource.data; }
      function changed() { return n().diff(d()).affectedKeys(); }
      function seatChanges() { return n().players.diff(d().players).affectedKeys(); }
      function isPlayer() { return me() in d().players; }
      function started() { return d().status in ['countdown','live','done']; }
      function expired() { return !started() && d().createdAt < request.time - duration.value(30, 'm'); }
      function freshSeat(p) { return p.keys().hasOnly(['name','ready','joinedAt']) && p.name is string
        && p.name.size() <= 40 && p.ready == false && p.joinedAt == request.time; }
      function newRoom() { return n().code == code && n().createdBy == me() && n().status == 'waiting'
        && n().startAt == null && n().createdAt == request.time
        && n().players.keys().hasOnly([me()]) && freshSeat(n().players[me()]) && stakeOk(); }
      // Zabba Token wager (optional): stake set once at create; countdown needs both seated stakes in escrow
      // (wagers/{key}, written only by the server). WAGER, not yet published.
      function stakeOk() { return !('stake' in n()) || (n().stake is int && n().stake >= 1); }
      function wagerPath() { return /databases/$(database)/documents/wagers/$('plank_' + code + '_' + string(d().createdAt.toMillis())); }
      function wagerReady() { return !('stake' in d()) || (exists(wagerPath()) && get(wagerPath()).data.status == 'open'
        && get(wagerPath()).data.players.keys().hasAll(d().players.keys())); }
      // Plank Battles result (plank-battle.js): own write-once result, only while live. RESULT, not yet published.
      function plankResOk(o, p) { return !('result' in p.diff(o).affectedKeys()) || (!('result' in o) && d().status == 'live'
        && ((p.result.keys().hasOnly(['forfeit','at']) && p.result.forfeit == true && p.result.at == request.time)
          || (p.result.keys().hasOnly(['holdMs','verified','at']) && p.result.holdMs is int && p.result.holdMs >= 0
            && p.result.holdMs <= 7200000 && p.result.verified is bool && p.result.at == request.time))); }
      allow read: if signedIn();
      allow create: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{4}$') && newRoom();
      allow update: if signedIn() && (
        // reuse an ended/expired code
        ((d().status in ['abandoned','done'] || expired()) && newRoom())
        // join an open seat (max 2), before start
        || (!isPlayer() && !started() && d().status == 'waiting' && !expired() && d().players.size() < 2
          && changed().hasOnly(['players']) && seatChanges().hasOnly([me()]) && freshSeat(n().players[me()]))
        // a seated player: own seat fields only (ready / seenAt / leftAt); before start may also free own seat
        || (isPlayer() && changed().hasOnly(['players','status']) && seatChanges().hasOnly([me()])
          && (!('status' in changed()) || (!started() && !(me() in n().players)
              && n().status == (n().players.size() == 0 ? 'abandoned' : 'waiting')))
          && (!(me() in n().players) ? !started()
              : n().players[me()].diff(d().players[me()]).affectedKeys().hasOnly(['ready','seenAt','leftAt','result'])
                && (!started() || !('ready' in n().players[me()].diff(d().players[me()]).affectedKeys()))
                && plankResOk(d().players[me()], n().players[me()])))
        // either player: both ready -> countdown with startAt = now..now+15s (only once)
        || (isPlayer() && d().status == 'waiting' && d().startAt == null && d().players.size() == 2
          && d().players[d().players.keys()[0]].ready == true && d().players[d().players.keys()[1]].ready == true
          && changed().hasOnly(['status','startAt']) && n().status == 'countdown' && n().startAt is int && wagerReady()
          && n().startAt > request.time.toMillis() && n().startAt < request.time.toMillis() + 15000)
        // either player: countdown -> live once startAt has (nearly) passed
        || (isPlayer() && d().status == 'countdown' && changed().hasOnly(['status']) && n().status == 'live'
          && request.time.toMillis() >= d().startAt - 2000)
      );
      allow delete: if false;
    }

    // TUT Battles rooms: same model as Plank Battles plus live stats + result. DRAFT, not yet published.
    match /tutBattles/{code} {
      function signedIn() { return request.auth != null; }
      function me() { return request.auth.uid; }
      function d() { return resource.data; }
      function n() { return request.resource.data; }
      function changed() { return n().diff(d()).affectedKeys(); }
      function seatChanges() { return n().players.diff(d().players).affectedKeys(); }
      function isPlayer() { return me() in d().players; }
      function started() { return d().status in ['countdown','live','done']; }
      function expired() { return !started() && d().createdAt < request.time - duration.value(30, 'm'); }
      function freshSeat(p) { return p.keys().hasOnly(['name','ready','joinedAt']) && p.name is string
        && p.name.size() <= 40 && p.ready == false && p.joinedAt == request.time; }
      function newRoom() { return n().code == code && n().createdBy == me() && n().status == 'waiting'
        && n().startAt == null && n().createdAt == request.time
        && n().players.keys().hasOnly([me()]) && freshSeat(n().players[me()]) && stakeOk(); }
      // Zabba Token wager (optional): stake set once at create; countdown needs both seated stakes in escrow
      // (wagers/{key}, written only by the server). WAGER, not yet published.
      function stakeOk() { return !('stake' in n()) || (n().stake is int && n().stake >= 1); }
      function wagerPath() { return /databases/$(database)/documents/wagers/$('tut_' + code + '_' + string(d().createdAt.toMillis())); }
      function wagerReady() { return !('stake' in d()) || (exists(wagerPath()) && get(wagerPath()).data.status == 'open'
        && get(wagerPath()).data.players.keys().hasAll(d().players.keys())); }
      allow read: if signedIn();
      allow create: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{4}$') && newRoom();
      allow update: if signedIn() && (
        // reuse an ended/expired code
        ((d().status in ['abandoned','done'] || expired()) && newRoom())
        // join an open seat (max 2), before start
        || (!isPlayer() && !started() && d().status == 'waiting' && !expired() && d().players.size() < 2
          && changed().hasOnly(['players']) && seatChanges().hasOnly([me()]) && freshSeat(n().players[me()]))
        // a seated player: own seat fields only (ready / seenAt / leftAt); before start may also free own seat
        || (isPlayer() && changed().hasOnly(['players','status']) && seatChanges().hasOnly([me()])
          && (!('status' in changed()) || (!started() && !(me() in n().players)
              && n().status == (n().players.size() == 0 ? 'abandoned' : 'waiting')))
          && (!(me() in n().players) ? !started()
              : n().players[me()].diff(d().players[me()]).affectedKeys().hasOnly(['ready','seenAt','leftAt','reps','tutMs'])
                && (!started() || !('ready' in n().players[me()].diff(d().players[me()]).affectedKeys()))))
        // either player: both ready -> countdown with startAt = now..now+15s (only once)
        || (isPlayer() && d().status == 'waiting' && d().startAt == null && d().players.size() == 2
          && d().players[d().players.keys()[0]].ready == true && d().players[d().players.keys()[1]].ready == true
          && changed().hasOnly(['status','startAt']) && n().status == 'countdown' && n().startAt is int && wagerReady()
          && n().startAt > request.time.toMillis() && n().startAt < request.time.toMillis() + 15000)
        // either player: countdown -> live once startAt has (nearly) passed
        || (isPlayer() && d().status == 'countdown' && changed().hasOnly(['status']) && n().status == 'live'
          && request.time.toMillis() >= d().startAt - 2000)
      ) || (signedIn() && me() in d().players && (
        // loser reports itself (first break wins the race; only while live)
        (d().status == 'live' && !('loserUid' in d())
          && changed().hasOnly(['status','loserUid','winnerUid','loseReason','endedAt','players'])
          && seatChanges().hasOnly([me()]) && n().status == 'done' && n().loserUid == me()
          && n().winnerUid != me() && n().winnerUid in d().players && n().endedAt == request.time
          && n().loseReason in ['standing','knees','frame','stopped','left'])
        // rematch pointer after the result
        || (d().status == 'done' && changed().hasOnly(['rematchCode','rematchBy']) && n().rematchBy == me()
          && n().rematchCode is string && n().rematchCode.matches('^[A-HJ-NP-Z2-9]{4}$'))
      ));
      allow delete: if false;
    }

    // Zabba Washer Battle rooms (washers-battle.js + battle-rooms.js), Bariboshi style (rules.html v1.9). Seats keyed by
    // request.auth.uid. No video: each player writes ONLY their own seat: a heartbeat (seenAt = server time), optional
    // live steps, an APPEND-ONLY list of write-once reports (rep: Bariboshi distance, round pack, confirm/dispute of the
    // opponent's report, ruling by the Bariboshi winner), a forfeit result {forfeit:true, at}, and claimGone (the other
    // seat's heartbeat is > 30 s stale). No winner field and no scores are stored: both phones derive order, scores and
    // winner from the reports. 'opener' kept for compatibility. Wager hooks stay inert when no stake is set.
    // DRAFT, not yet published. (Not run against the emulator: needs a two-phone test before publishing.)
    match /washersBattles/{code} {
      function signedIn() { return request.auth != null; }
      function me() { return request.auth.uid; }
      function d() { return resource.data; }
      function n() { return request.resource.data; }
      function changed() { return n().diff(d()).affectedKeys(); }
      function seatChanges() { return n().players.diff(d().players).affectedKeys(); }
      function isPlayer() { return me() in d().players; }
      function started() { return d().status in ['countdown','live','done']; }
      function expired() { return !started() && d().createdAt < request.time - duration.value(30, 'm'); }
      function freshSeat(p) { return p.keys().hasOnly(['name','ready','joinedAt']) && p.name is string
        && p.name.size() <= 40 && p.ready == false && p.joinedAt == request.time; }
      function newRoom() { return n().code == code && n().createdBy == me() && n().status == 'waiting'
        && n().startAt == null && n().createdAt == request.time
        && n().players.keys().hasOnly([me()]) && freshSeat(n().players[me()]) && stakeOk(); }
      // Zabba Token wager (optional): stake set once at create; countdown needs both seated stakes in escrow
      // (wagers/{key}, written only by the server). WAGER, not yet published. No stake = both checks pass.
      function stakeOk() { return !('stake' in n()) || (n().stake is int && n().stake >= 1); }
      function wagerPath() { return /databases/$(database)/documents/wagers/$('washers_' + code + '_' + string(d().createdAt.toMillis())); }
      function wagerReady() { return !('stake' in d()) || (exists(wagerPath()) && get(wagerPath()).data.status == 'open'
        && get(wagerPath()).data.players.keys().hasAll(d().players.keys())); }
      // Reports (rep). packOk: a pack of exactly 3 washers, each 0 out / 2 box-bound / 3 shoot / 5 bank (Art. 5.1, 6).
      function packOk(a) { return a is list && a.size() == 3 && a[0] in [0,2,3,5] && a[1] in [0,2,3,5] && a[2] in [0,2,3,5]; }
      function repOk(e) {
        return (e.keys().hasAll(['k','n','d']) && e.keys().hasOnly(['k','n','d']) && e.k == 'b' && e.n is int && e.n >= 1 && e.n <= 8
            && e.d is int && e.d >= 0 && e.d <= 2000)
          || (e.keys().hasAll(['k','n','pack']) && e.keys().hasOnly(['k','n','pack']) && e.k == 'r' && e.n is int && e.n >= 1 && e.n <= 30 && packOk(e.pack))
          || (e.keys().hasAll(['k','t','n','ok']) && e.keys().hasOnly(['k','t','n','ok']) && e.k == 'c' && e.t in ['b','r']
            && e.n is int && e.n >= 1 && e.n <= 30 && e.ok is bool)
          || (e.keys().hasAll(['k','n','who','pack']) && e.keys().hasOnly(['k','n','who','pack']) && e.k == 'x' && e.n is int
            && e.n >= 1 && e.n <= 30 && e.who in n().players && packOk(e.pack)); }
      // append-only: the existing entries are unchanged and at most one new, valid entry is added per write
      function repGrows(o, p) { return !('rep' in p) ? !('rep' in o)
        : ('rep' in o ? (p.rep.size() >= o.rep.size() && p.rep.size() <= o.rep.size() + 1 && p.rep[0:o.rep.size()] == o.rep
              && (p.rep.size() == o.rep.size() || repOk(p.rep[o.rep.size()])))
            : (p.rep.size() == 1 && repOk(p.rep[0]))); }
      function otherSeat() { return d().players[d().players.keys().removeAll([me()])[0]]; }
      function lastSeen() { return ('seenAt' in otherSeat() && otherSeat().seenAt.toMillis() > d().startAt) ? otherSeat().seenAt.toMillis() : d().startAt; }
      function otherStale() { return d().players.size() == 2 && d().startAt is int && request.time.toMillis() - lastSeen() > 30000; }
      function resOk(x) { return x.keys().hasOnly(['forfeit','at']) && x.forfeit == true && x.at == request.time; }
      function seatOk(o, p) {
        return (!('opener' in p) || p.opener in n().players)
          && (!('steps' in p) || (p.steps is int && p.steps >= 0 && p.steps <= 100000))
          && (!('seenAt' in p.diff(o).affectedKeys()) || p.seenAt == request.time)
          && ('result' in o ? p.diff(o).affectedKeys().hasOnly(['seenAt','leftAt','opener'])
              : (!('result' in p) || (d().status == 'live' && resOk(p.result))))
          && (!('rep' in p.diff(o).affectedKeys()) || (d().status == 'live' && repGrows(o, p) && !('claimGone' in otherSeat())))
          && (!('claimGone' in p.diff(o).affectedKeys()) || (p.claimGone == true && d().status == 'live' && otherStale()))
          && (!('steps' in p.diff(o).affectedKeys()) || d().status == 'live');
      }
      allow read: if signedIn();
      allow create: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{4}$') && newRoom();
      allow update: if signedIn() && (
        // reuse an ended/expired code
        ((d().status in ['abandoned','done'] || expired()) && newRoom())
        // join an open seat (max 2), before start
        || (!isPlayer() && !started() && d().status == 'waiting' && !expired() && d().players.size() < 2
          && changed().hasOnly(['players']) && seatChanges().hasOnly([me()]) && freshSeat(n().players[me()]))
        // a seated player: own seat fields only (ready / seenAt / leftAt); before start may also free own seat
        || (isPlayer() && changed().hasOnly(['players','status']) && seatChanges().hasOnly([me()])
          && (!('status' in changed()) || (!started() && !(me() in n().players)
              && n().status == (n().players.size() == 0 ? 'abandoned' : 'waiting')))
          && (!(me() in n().players) ? !started()
              : n().players[me()].diff(d().players[me()]).affectedKeys().hasOnly(['ready','seenAt','leftAt','opener','steps','result','rep','claimGone'])
                && seatOk(d().players[me()], n().players[me()])
                && (!started() || !('ready' in n().players[me()].diff(d().players[me()]).affectedKeys()))))
        // either player: both ready -> countdown with startAt = now..now+15s (only once)
        || (isPlayer() && d().status == 'waiting' && d().startAt == null && d().players.size() == 2
          && d().players[d().players.keys()[0]].ready == true && d().players[d().players.keys()[1]].ready == true
          && changed().hasOnly(['status','startAt']) && n().status == 'countdown' && n().startAt is int && wagerReady()
          && n().startAt > request.time.toMillis() && n().startAt < request.time.toMillis() + 15000)
        // either player: countdown -> live once startAt has (nearly) passed
        || (isPlayer() && d().status == 'countdown' && changed().hasOnly(['status']) && n().status == 'live'
          && request.time.toMillis() >= d().startAt - 2000)
      );
      allow delete: if false;
    }

    // TUT battle ranking: each player writes only their own row, from a finished battle they were in. DRAFT.
    match /tutBattleStats/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','name','wins','losses','battles','bestTutMs','bestReps','lastBattle','updatedAt'])
        && request.resource.data.uid == uid && request.resource.data.updatedAt == request.time
        && request.resource.data.lastBattle is string
        && get(/databases/$(database)/documents/tutBattles/$(request.resource.data.lastBattle)).data.status == 'done'
        && uid in get(/databases/$(database)/documents/tutBattles/$(request.resource.data.lastBattle)).data.players
        && (resource == null || resource.data.lastBattle != request.resource.data.lastBattle)
        && request.resource.data.wins is int && request.resource.data.losses is int
        && request.resource.data.wins + request.resource.data.losses
           == (resource == null ? 0 : resource.data.wins + resource.data.losses) + 1;
      allow delete: if false;
    }

    // Zabba Tokens (earn only; no spend/wagering yet). Owner-only read.
    // users/{uid}.zabaTokens may only change together with a NEW tokenTx entry in the same
    // transaction/batch (lastTxId points at it, delta == its amount). Tx entries are create-once
    // (id = source-setId => retries can't double-credit) and capped by the rate for their units.
    // Zabba Token wager escrow: server only (netlify/functions wager-stake / wager-settle / wager-sweep, admin SDK).
    // Players can read to see stakes and the outcome. WAGER, not yet published.
    match /wagers/{key} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/{uid} {
      function txPath(id) { return /databases/$(database)/documents/users/$(uid)/tokenTx/$(id); }
      function u() { return request.resource.data; }
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && u().keys().hasOnly(['uid','zabaTokens','lastTxId','createdAt','updatedAt'])
        && u().uid == uid && u().zabaTokens is int && u().lastTxId is string
        && u().createdAt == request.time && u().updatedAt == request.time
        && (u().zabaTokens == 0 && u().lastTxId == ''
            || (!exists(txPath(u().lastTxId)) && existsAfter(txPath(u().lastTxId))
                && getAfter(txPath(u().lastTxId)).data.amount == u().zabaTokens));
      allow update: if request.auth != null && request.auth.uid == uid
        && u().diff(resource.data).affectedKeys().hasOnly(['zabaTokens','lastTxId','updatedAt'])
        && u().zabaTokens is int && u().zabaTokens >= 0 && u().updatedAt == request.time
        && u().lastTxId is string && u().lastTxId != resource.data.lastTxId
        && !exists(txPath(u().lastTxId)) && existsAfter(txPath(u().lastTxId))
        && u().zabaTokens == resource.data.zabaTokens + getAfter(txPath(u().lastTxId)).data.amount;
      allow delete: if false;

      match /tokenTx/{txId} {
        function t() { return request.resource.data; }
        function userPath() { return /databases/$(database)/documents/users/$(uid); }
        function before() { return exists(userPath()) ? get(userPath()).data.zabaTokens : 0; }
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && t().keys().hasOnly(['uid','type','source','amount','units','qty','setId','createdAt'])
          // clients: earn only. stake / payout / refund entries are written by the server (admin SDK bypasses rules).
          && t().uid == uid && t().type == 'earn' && t().createdAt == request.time
          && t().setId is string && t().setId.matches('^[A-Za-z0-9_-]{1,60}$')
          && txId == t().source + '-' + t().setId
          && t().qty is int && t().qty >= 0 && t().amount is int && t().amount >= 1
          && ((t().source == 'pushups' && t().units == 'reps'    && t().qty <= 5000 && t().amount * 10 <= t().qty)
           || (t().source == 'plank'   && t().units == 'seconds' && t().qty <= 7200 && t().amount * 60 <= t().qty)
           || (t().source == 'tut'     && t().units == 'seconds' && t().qty <= 7200 && t().amount * 60 <= t().qty)
           || (t().source == 'walk'    && t().units == 'minutes' && t().qty <= 240  && t().amount * 10 <= t().qty)
           || (t().source == 'washers' && t().units == 'wins'    && t().qty == 1    && t().amount == 1))
          && getAfter(userPath()).data.lastTxId == txId
          && getAfter(userPath()).data.zabaTokens == before() + t().amount;
        allow update, delete: if false;
      }
    }

    // Zabba reputation (reputation.js): public mirror, name + score only (never an email). Read by any signed-in user;
    // written ONLY by the server (netlify/functions/rep-settle.js, admin SDK). Nobody can edit their own reputation.
    // repLog/{key}: server-only ledger so each match counts once. DRAFT, not yet published.
    match /repBoard/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /repLog/{key} {
      allow read, write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
